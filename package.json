{
  "name": "dff-sim",
  "version": "1.0.0",
  "description": "D-FlipFlop Simulation",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist && echo 'Done.'",
    "lint": "eslint src/**/*.ts",
    "lint:scss": "stylelint \"src/styles/**/*.scss\"",
    "lint:all": "bun lint && bun lint:scss",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "d-flip-flop",
    "simulation",
    "digital-circuit"
  ],
  "author": "Romeo Ahmed <ahmedorqwn@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.8",
    "@types/node": "^25.2.2",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "sass-embedded": "^1.97.3",
    "stylelint": "^17.1.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "8.0.0-beta.13"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "pixi.js": "^8.16.0"
  },
  "trustedDependencies": [
    "@parcel/watcher"
  ]
}
